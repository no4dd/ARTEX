# Minimal local ARTEX image for ChatGPT sign-in and a first scoped test.
# It omits the standard image's third-party scanner installers.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN NEXT_TELEMETRY_DISABLED=1 npm run build:static

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/out ./server/webui/dist
ARG TARGETOS
ARG TARGETARCH
RUN ARTEX_SKIP_FRONTEND=1 ARTEX_SKIP_NPM_CI=1 ARTEX_COMPRESS=0 ARTEX_OUTPUT=/out/artex \
    bash ./build.sh --target "${TARGETOS:-linux}/${TARGETARCH:-amd64}"

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash curl jq nmap python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/artex /app/artex
COPY start.sh /app/start.sh
COPY start-plan-local.sh /app/start-plan-local.sh
COPY scripts/plan_target_forward.py /app/scripts/plan_target_forward.py
COPY skills/ /app/skills/
RUN chmod 0755 /app/artex /app/start.sh /app/start-plan-local.sh && mkdir -p /app/data /app/keys
EXPOSE 8787 8788
ENTRYPOINT ["/app/start-plan-local.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
